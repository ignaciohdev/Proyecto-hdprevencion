# API Key de Google Gemini (solo scripts de desarrollo local, sin uso en runtime web)
GEMINI_API_KEY=tu_gemini_api_key_aqui
ADMIN_NUMBER=56900000000

# Configuración de Django
DJANGO_SECRET_KEY=django-insecure-cambiar-en-produccion
DJANGO_DEBUG=True
# Ruta del panel admin backend (debe coincidir con NEXT_PUBLIC_ADMIN_PATH en frontend)
# DJANGO_ADMIN_PATH=sst-control-panel/
# En producción con múltiples orígenes Vercel preview temporales (no recomendado en prod final):
# ALLOW_VERCEL_PREVIEW_CORS=False
# FRONTEND_URL=https://tu-dominio.vercel.app
# Exigir MFA TOTP en backend a staff/superuser/corporativos (en Render producción activo por defecto):
# MFA_ENFORCE_PRIVILEGED=False
# Comprobación HIBP k-anonymity al registrar o cambiar contraseñas (en Render producción activa por defecto):
# HIBP_CHECK_ENABLED=False

# Clave independiente para cifrado autenticado en reposo de campos sensibles (Ley 21.719)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=generar_clave_fernet_independiente_aqui
# Clave dedicada para blind index HMAC-SHA256 de RUTs cifrados:
BLIND_INDEX_KEY=generar_clave_hmac_independiente_aqui
# Opcional durante rotación de llaves (lista separada por comas):
# FIELD_ENCRYPTION_OLD_KEYS=

# Configuración de Base de Datos PostgreSQL
DB_NAME=prevencion_hd_db
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
# Alternativa: DATABASE_URL=postgresql://user:password@host:port/dbname
